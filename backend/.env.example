# SkillBarter Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── PostgreSQL (FREE options below) ──────────────────────────
# Option 1: Supabase (free) → https://supabase.com
# Option 2: Neon (free)     → https://neon.tech
# Option 3: Railway (free)  → https://railway.app
# Option 4: Local PostgreSQL → postgresql://postgres:password@localhost:5432/skillbarter

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/skillbarter?schema=public"

# ── JWT Secret ────────────────────────────────────────────────
JWT_SECRET=skillbarter_secret_2026_change_this_in_production

# ── Server Port ───────────────────────────────────────────────
PORT=5000

# ── Environment ───────────────────────────────────────────────
NODE_ENV=development
